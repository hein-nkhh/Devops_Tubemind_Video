pipeline {
    agent any

    environment {
        // Cấu hình thông tin AWS & ECR
        AWS_REGION = 'us-east-1'
        ECR_REGISTRY = '039968205787.dkr.ecr.us-east-1.amazonaws.com'
        
        // Tên các Image
        IMAGE_TRANSCRIBER = 'tubemind/transcriber'
        IMAGE_SUMMARIZER = 'tubemind/summarizer'
        IMAGE_NOTIFIER = 'tubemind/notifier'
        IMAGE_API = 'tubemind/api-gateway'
        
        // Tag phiên bản (Dùng số Build của Jenkins làm Tag)
        IMAGE_TAG = "v1.0.${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout Source') {
            steps {
                // Lấy code từ Git về
                checkout scm
            }
        }

        stage('Build & Push Docker') {
            // [QUAN TRỌNG] Đoạn này sửa lỗi "docker/aws not found"
            // Chúng ta dùng image 'docker:cli' có sẵn docker để chạy stage này
            agent {
                docker {
                    image 'docker:cli' 
                    // Map socket để container con gọi được Docker của máy chủ
                    args '-v /var/run/docker.sock:/var/run/docker.sock -u root'
                }
            }
            steps {
                script {
                    echo "--- 🛠️ Installing AWS CLI & Git ---"
                    // Cài nhanh AWS CLI và Git vào trong agent tạm thời này
                    sh 'apk add --no-cache aws-cli git'

                    echo "--- 🔑 Login AWS ECR ---"
                    // Lệnh này giờ sẽ chạy OK vì đã có aws-cli
                    sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"

                    echo "--- 🐳 Build & Push Images ---"
                    
                    // 1. Transcriber
                    sh "docker build -t ${ECR_REGISTRY}/${IMAGE_TRANSCRIBER}:${IMAGE_TAG} -f services/transcriber_worker/Dockerfile ."
                    sh "docker push ${ECR_REGISTRY}/${IMAGE_TRANSCRIBER}:${IMAGE_TAG}"

                    // 2. Summarizer
                    sh "docker build -t ${ECR_REGISTRY}/${IMAGE_SUMMARIZER}:${IMAGE_TAG} -f services/summarizer_worker/Dockerfile ."
                    sh "docker push ${ECR_REGISTRY}/${IMAGE_SUMMARIZER}:${IMAGE_TAG}"

                    // 3. Notifier
                    sh "docker build -t ${ECR_REGISTRY}/${IMAGE_NOTIFIER}:${IMAGE_TAG} -f services/notifier_service/Dockerfile ."
                    sh "docker push ${ECR_REGISTRY}/${IMAGE_NOTIFIER}:${IMAGE_TAG}"

                    // 4. API Gateway (Nếu có)
                    // sh "docker build -t ${ECR_REGISTRY}/${IMAGE_API}:${IMAGE_TAG} -f services/api_gateway/Dockerfile ."
                    // sh "docker push ${ECR_REGISTRY}/${IMAGE_API}:${IMAGE_TAG}"
                }
            }
        }

        stage('Update Helm values.yaml') {
            agent {
                docker {
                    // 1. Đổi sang image alpine/git (Rất nhẹ và tương thích tốt)
                    image 'alpine/git' 
                    // 2. Quan trọng: Overwrite entrypoint để Jenkins điều khiển được container
                    args '--entrypoint="" -u root'
                }
            }
            steps {
                script {
                    checkout scm
                    echo "--- 📝 Updating Helm Chart Version ---"
                    
                    // Debug: Liệt kê file để chắc chắn file tồn tại (Nếu lỗi sẽ thấy ngay)
                    sh 'ls -la k8s/helm/tubemind/'

                    // Cấu hình Git
                    sh 'git config --global user.email "jenkins@tubemind.local"'
                    sh 'git config --global user.name "Jenkins Bot"'
                    // Sửa lỗi "dubious ownership" do chạy quyền root
                    sh 'git config --global --add safe.directory /var/jenkins_home/workspace/tubemind-deploy'
                    sh 'git config --global --add safe.directory /var/jenkins_home/workspace/tubemind-deploy@2'

                    // Chạy lệnh sed thay thế
                    sh """
                        sed -i 's/imageTag: .*/imageTag: "${IMAGE_TAG}"/g' k8s/helm/tubemind/values.yaml
                    """

                    // Kiểm tra xem file đã đổi chưa (Debug)
                    sh 'grep "imageTag" k8s/helm/tubemind/values.yaml'

                    echo "--- 💾 Committing changes ---"
                    withCredentials([usernamePassword(credentialsId: 'github-login', passwordVariable: 'GIT_PASSWORD', usernameVariable: 'GIT_USERNAME')]) {
                        sh "git add k8s/helm/tubemind/values.yaml"
                        sh "git commit -m 'Jenkins update image tag to ${IMAGE_TAG}'"
                        sh "git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/hein-nkhh/Devops_Tubemind_Video.git HEAD:main"
                    }
                }
            }
        }
    }
}