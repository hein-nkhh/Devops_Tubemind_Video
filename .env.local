# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=tubemind_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password
MINIO_BUCKET_NAME=tubemind-videos
MINIO_SECURE=false

# MailHog
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=noreply@tubemind.local

# API Keys & Config
GEMINI_API_KEY=add_key_here
WHISPER_MODEL_SIZE=base
TEMP_DIR=/tmp/tubemind
